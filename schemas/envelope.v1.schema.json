{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/s-bidowaniec/spatial-cad-mcp/schemas/envelope.v1.schema.json",
  "title": "spatial-cad-mcp tool response envelope v1",
  "description": "The single response shape of every MCP tool in this monorepo, in both the Python (mcp_cad_core.responses) and the Rust (cad-envelope) implementations. Clients can validate any tool result against this schema.",
  "type": "object",
  "oneOf": [
    {
      "title": "success",
      "required": ["ok", "data", "meta"],
      "properties": {
        "ok": { "const": true },
        "data": { "type": "object" },
        "meta": { "$ref": "#/$defs/meta" }
      }
    },
    {
      "title": "failure",
      "required": ["ok", "error", "meta"],
      "properties": {
        "ok": { "const": false },
        "error": { "$ref": "#/$defs/error" },
        "meta": { "$ref": "#/$defs/meta" }
      }
    }
  ],
  "$defs": {
    "meta": {
      "type": "object",
      "properties": {
        "tool": { "type": "string", "minLength": 1 },
        "duration_ms": { "type": "number", "minimum": 0 },
        "truncated": { "type": "boolean" },
        "truncated_values": { "type": "integer", "minimum": 0 },
        "pagination": {
          "type": "object",
          "required": ["total", "limit", "offset", "returned", "has_more"],
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "limit": { "type": "integer", "minimum": 1 },
            "offset": { "type": "integer", "minimum": 0 },
            "returned": { "type": "integer", "minimum": 0 },
            "has_more": { "type": "boolean" },
            "next_offset": { "type": ["integer", "null"], "minimum": 0 },
            "limit_clamped_to": { "type": "integer", "minimum": 1, "maximum": 200 }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "error": {
      "type": "object",
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" },
        "hints": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "details": { "type": "object" }
      },
      "additionalProperties": true
    }
  }
}
